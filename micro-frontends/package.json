    "preview": "vite preview"
  },
  "dependencies": {
    "@primeicons/react": "^8.0.0",
    "@primereact/core": "^11.2.2",
    "@primereact/ui": "^11.2.2",
    "@primeuix/themes": "^3.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
