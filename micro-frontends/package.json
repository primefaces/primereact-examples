{
  "name": "primereact-micro-frontends",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:orders": "vite build --config vite.orders.config.ts",
    "build:customers": "vite build --config vite.customers.config.ts",
    "dev": "npm run build:orders && npm run build:customers && vite",
